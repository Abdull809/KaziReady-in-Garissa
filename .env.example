# Optional Supabase Configuration
# When both variables are provided, KaziReady Garissa connects to Supabase Auth & Postgres.
# When omitted, the application runs in full persistent localStorage demonstration mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configurable Support Contact Details (Garissa County, Kenya)
VITE_CONTACT_EMAIL=support@kazireadygarissa.demo
VITE_CONTACT_PHONE=+254 700 000 000 (Demo Line)
VITE_CONTACT_OFFICE=Garissa County Innovation & Youth Support Desk (Demo Location)
